# ---------------------------------------------------------------------------
# Storage (optional)
# ---------------------------------------------------------------------------
# Vercel KV is used when both variables are present; otherwise the sandbox
# falls back to JSON files under data/ for local development.
# Vercel sets these automatically when you attach a KV store to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Fallback callback target when a request does not supply one.
DEFAULT_CALLBACK_URL=http://localhost:3001/payment/callback

# Public origin of this sandbox, used to build redirect URLs.
MOCK_SERVER_URL=http://localhost:3000

# Rewrite callback/return hosts before they are used. Useful when replaying a
# payload captured from production so callbacks land on staging instead.
# Comma-separated `from=>to` host pairs; unset means no rewriting.
# URL_REWRITE_RULES=api.example.com=>staging-api.example.com,example.com=>staging.example.com

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Password for the admin dashboard and the /api/admin/* endpoints.
ADMIN_PASSWORD=mockpay

# ---------------------------------------------------------------------------
# Public deployment hardening
# ---------------------------------------------------------------------------
# Refuse to send callbacks to private, loopback or link-local addresses.
# Leave unset (or "true") for local development, where posting to
# http://localhost:3001 is the normal case. Set to "false" on a public
# deployment so the sandbox cannot be used to reach internal services.
# ALLOW_PRIVATE_CALLBACKS=false

# Requests permitted per client IP per minute on the provider and demo APIs.
# Defaults to 60; set to 0 to disable rate limiting entirely.
# RATE_LIMIT_MAX=60
